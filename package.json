{
  "name": "icloud-hide-my-email-browser-extension",
  "version": "1.2.11",
  "description": "Cross-browser extension enabling the usage of iCloud's Hide My Email service.",
  "license": "MIT",
  "author": "dedoussis",
  "repository": {
    "type": "git",
    "url": "https://github.com/dedoussis/icloud-hide-my-email-browser-extension.git"
  },
  "scripts": {
    "prebuild": "rm -rf build",
    "build": "node utils/build.js",
    "prebuild:firefox": "rm -rf build",
    "build:firefox": "FIREFOX=true node utils/build.js",
    "start": "node utils/webserver.js",
    "start:firefox": "FIREFOX=true node utils/webserver.js",
    "lint": "oxlint .",
    "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,scss,md,eslintrc}'",
    "prettier:check": "prettier --check '**/*.{js,jsx,ts,tsx,json,css,scss,md,eslintrc}'",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "fast-deep-equal": "^3.1.3",
    "fuse.js": "^6.6.2",
    "lodash.startcase": "^4.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^14.0.3",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.0.243",
    "@types/lodash.startcase": "^4.4.7",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.1",
    "baseline-browser-mapping": "^2.11.29",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.6.0",
    "express": "^5.3.0",
    "html-loader": "^3.1.0",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.6.1",
    "oxlint": "^1.88.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.16",
    "postcss-loader": "^7.0.1",
    "prettier": "^2.5.1",
    "sass": "^1.94.0",
    "sass-loader": "^16.0.6",
    "style-loader": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "terser-webpack-plugin": "^5.3.1",
    "ts-loader": "^9.2.6",
    "typescript": "^5.9.3",
    "webpack": "^5.112.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-middleware": "^8.4.0",
    "webpack-hot-middleware": "^2.26.1"
  }
